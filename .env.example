# Sao chép sang .env CHỈ khi chưa có .env. Không commit khóa API thật.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
TRANSLATION_MODEL=qwen/qwen3.8-27b
# auto: Qwen = none, GPT-OSS 20b/120b = low; provider bỏ tham số.
GROQ_REASONING_EFFORT=auto
TRANSLATION_REASONING_EFFORT=auto
TRANSLATION_CHUNK_SIZE=1800
MAX_TRANSLATION_CHARS=200000
# Chỉ cần nếu chọn Google Cloud Translation. Có quota miễn phí, không miễn phí vô hạn.
GOOGLE_TRANSLATE_API_KEY=

# Model đa ngôn ngữ chạy local; cần Internet để tải lần đầu.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# Máy NVIDIA đã cài requirements-gpu.txt: EMBEDDING_DEVICE=cuda, OCR_GPU=true.
OCR_GPU=false
# paddle: cài thêm requirements-ocr-quality.txt; đọc tài liệu nhiều cột trên CPU.
OCR_ENGINE=easyocr
OCR_DPI=200
OCR_MIN_TEXT_CHARS=40
OCR_PAGE_TIMEOUT=120
# GPU: nhận dạng theo batch nhỏ; tự giảm batch/canvas nếu thiếu VRAM.
OCR_BATCH_SIZE=4

# Bỏ trống để tự tìm Release-*/poppler-*/Library/bin hoặc dùng PATH.
# Ví dụ Windows: POPPLER_PATH=E:/BIG_RAG/Release-26.09.0-0/poppler-26.09.0/Library/bin
POPPLER_PATH=
DATA_DIR=data
VECTOR_DB_DIR=vector_db
# Bootstrap bằng admin một lần; db:setup tạo user MySQL CRUD riêng trong .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=big_rag
MYSQL_MANAGED=false
MYSQL_SSL=false
MYSQL_USER=
MYSQL_PASSWORD=
WEB_PORT=8501
# db:setup tạo secret giữa API Python và engine RAG trong cùng tiến trình.
RAG_SERVICE_TOKEN=
COOKIE_SECURE=false
CHUNK_SIZE=900
CHUNK_OVERLAP=150
# Mặc định chia theo tokenizer embedding. CHUNK_SIZE/OVERLAP chỉ dùng khi characters.
CHUNK_UNIT=tokens
CHUNK_TOKENS=480
CHUNK_OVERLAP_TOKENS=72
RETRIEVAL_K=4
# Tổng quan lấy ít nhất một đoạn mỗi file, tối đa 12; câu hỏi chi tiết vẫn dùng RETRIEVAL_K.
MAX_CONTEXT_CHUNKS=12
CONTEXT_TOKEN_BUDGET=1800
MAX_INPUT_TOKENS=3000
# Reranker chạy local; model BGE lớn, tải lần đầu và có thể chậm trên CPU.
# false dùng MMR sẵn có, vẫn áp dụng giới hạn ngữ cảnh/token ở trên.
RERANK_ENABLED=false
RERANK_CANDIDATES=20
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
# Khi bật reranker trên NVIDIA, đặt RERANK_DEVICE=cuda.
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
MAX_OUTPUT_TOKENS=1024

# Log console + storage/logs/{api,api-error,dev}.log; DEBUG để xem thêm health/debug.
LOG_LEVEL=INFO
# Tùy chọn đổi thư mục log: BIGRAG_LOG_DIR=E:/BIG_RAG/storage/logs
